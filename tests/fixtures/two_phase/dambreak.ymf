# The 2-D dam break of test/TwoPhaseFlow/damBreakLevelSet.py, split into
# proteus's five sub-problems (RANS2P, VOF, NCLS, RDLS, MCorr). The stored
# mesh (meshDambreak) waits on C7.1; this gives an element size instead.
extends: two_phase_level_set.ymf

model:
  name: "Dam break, 3.22 m × 1.8 m tank, 1.2 m × 0.6 m column (2-D)"
  physical_model: {provenance: human_specified}
  strong_form:
    domain: "Ω = [0, 3.22] × [0, 1.8],  t ∈ (0, 3]"
    boundary_regions:
      - {name: walls, where: "x = 0 or x = 3.22 or y = 0"}
      - {name: top, where: "y = 1.8"}
    boundary_sets:
      - {region: walls, set: free_slip}
      - {region: top, set: atmosphere}
    initial_conditions:
      - {field: v, type: constant, value: 0.0}
      - {field: p, type: constant, value: 0.0}
      - field: φ
        type: function
        # hypot, as damBreakLevelSet.py computes it (the sqrt of a sum of
        # squares rounds twice: one ulp off the deck at some nodes)
        formula: "hypot(max(x − 1.2, 0), max(y − 0.6, 0)) + min(max(x − 1.2, y − 0.6), 0)"
        units: m
    coefficients:
      ρw: {value: 998.2}
      νw: {value: 1.004e-6}
      ρa: {value: 1.205}
      νa: {value: 1.5e-5}
      g:  {formula: "(0, -9.8)"}

  # the deck's gauges: the level set along four verticals and one
  # horizontal (height1.csv, height2.csv), the pressure at three points on
  # the right wall (pressure.csv)
  gauges:
    - name: heights
      kind: line
      fields: [φ]
      lines: [[[2.724, 0.0], [2.724, 1.8]], [[2.228, 0.0], [2.228, 1.8]],
              [[1.732, 0.0], [1.732, 1.8]], [[0.582, 0.0], [0.582, 1.8]]]
      file: height1.csv
    - name: bottom
      kind: line
      fields: [φ]
      lines: [[[0.0, 0.0], [3.22, 0.0]]]
      file: height2.csv
    - name: pressure
      kind: point
      fields: [p]
      points: [[3.22, 0.16], [3.22, 0.584], [3.22, 0.12]]
      file: pressure.csv

solution_paths:
  analytical: []
  discretizations:
    - name: level_set_five
      provenance: proteus_derived
      mesh: {h: 0.0322}
      binds:
        h: {meaning: element_size}
        ε: {formula: "1.5 h"}
      regularize:
        heaviside: {by: smoothed_heaviside, width: ε}
      step_control: {type: min_cfl, cfl: 0.25, step_exact: true}
      solver: {type: nonlinear, nonlinear_solver: newton, linear_solver: petsc, max_iterations: 50}
      subproblems:
        - name: flow
          solves: [momentum, continuity]
          lags: {φ: previous_step, χ: {via: vof, at: previous_step}}
          finite_element: {velocity: {family: CG, order: 1}, pressure: {family: CG, order: 1}}
          time_integration: backward_euler
          solver: {max_iterations: 100}
          proteus: {model: RANS2P, useVF: 1.0}
        - name: vof
          introduces: {name: χh, approximates: χ, units: "1"}
          equation: "∂χh/∂t + ∇·(v χh) = 0"
          initial_condition: "heaviside(φ)"
          lags: {v: {via: flow, at: current_step}}
          finite_element: {fields: {family: CG, order: 1}}
          time_integration: backward_euler
        - name: ncls
          solves: [interface]
          lags: {v: {via: flow, at: current_step}}
          finite_element: {fields: {family: CG, order: 1}}
          time_integration: backward_euler
        - name: rdls
          enforces: "norm(∇φ) = 1"
          for: φ
          equation: "sign(φs) (norm(∇φ) − 1) = 0"
          lags: {φs: {of: φ, via: ncls, at: current_step}}
          regularize: {sign: {by: smoothed_sign, width: εr}}
          binds: {εr: {formula: "0.75 h"}}
          pseudo_time: steady
          writes_back: {φ: replace}
          finite_element: {fields: {family: CG, order: 1}}
        - name: mcorr
          enforces: "heaviside(φ) = χh"
          introduces: {name: φc, correction_of: φ, units: m}
          equation: "heaviside(φ + φc) − χh − ∇·(εd ∇φc) = 0"
          binds: {εd: {formula: "10 h"}}
          lags: {φ: {via: rdls, at: current_step}, χh: {via: vof, at: current_step}}
          writes_back: {φ: add}
          finite_element: {fields: {family: CG, order: 1}}
