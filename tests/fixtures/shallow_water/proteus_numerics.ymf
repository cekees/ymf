# How Proteus solves the shallow-water model: SW2DCV, the convex-limited
# graph-viscosity scheme with SSP RK3, as one sub-problem. Shared by the
# cases; each adds its mesh and may change the free-form scheme options.
extends: shallow_water.ymf
ymf_state: abstract

solution_paths:
  analytical: []
  discretizations:
    - name: convex_limited
      provenance: proteus_derived
      binds:
        he: {meaning: element_size}                 # h is the depth here
      regularize:                                   # a canopy's edge, over one element
        heaviside: {by: smoothed_heaviside, width: he}
      step_control: {type: min_cfl, cfl: 0.33}
      solver: {type: time_marching, linear_solver: petsc}
      # the scheme is algebraic (no weak form); its options free-form until
      # a second solver needs them typed
      discretization:
        scheme: graph_viscosity_convex_limiting
        time_integration: SSP_RK3
        entropy_viscosity_cE: 1.0
        lumped_mass: false
        bounds_relaxation: true
      subproblems:
        - name: swe
          solves: [mass, momentum]
          finite_element: {fields: {family: CG, order: 1}}
          time_integration: SSP_RK3
          proteus: {model: SW2DCV, INTEGRATE_BY_PARTS_WALLS: 1}
