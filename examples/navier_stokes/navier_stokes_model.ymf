# ============================================================
# YMF model: incompressible Navier-Stokes
#
# A model, not a problem. It fixes the physics, the equations and the
# unknowns, and declares which coefficients the equations need and in what
# units, but gives no domain, no boundary or initial conditions and no
# coefficient values. Each problem file in this directory extends it into
# a complete, well-posed problem:
#
#   navier_stokes_model.ymf
#   ├── planar_couette.ymf          shear-driven flow between plates
#   └── plane_poiseuille.ymf        pressure-driven flow between plates
#       └── plane_poiseuille_re100.ymf    the same flow at Re = 100
#
# For multiphysics the model is where most of the work goes, so it is
# written once and reviewed once.
# ============================================================

kind: model

Problem:
  physical_model:
    provenance: human_specified
    processes: [incompressible_flow]
    assumptions: [newtonian, constant_density, isothermal]

  units:
    convention: SI
    default: true

  strong_form:
    provenance: human_specified
    unknowns:
      - name: v
        units: m/s
        rank: 1          # a vector, one component per space dimension
      - name: p
        units: Pa
    equation_formulation: "incompressible Navier-Stokes, primitive variables"
    # The momentum equation is in conservative form: ∇·(ρ v⊗v) equals
    # ρ(v·∇)v when ∇·v = 0, and as a divergence it is an advective flux the
    # weak form integrates by parts. ∇p is part of that flux too (∇·(pI)),
    # so the natural boundary condition is the traction.
    equations:
      - "ρ ∂v/∂t + ∇·(ρ v⊗v) − μΔv + ∇p = f  in Ω"
      - "∇·v = 0  in Ω"
    # The coefficients the equations use, with units and no values: a
    # problem supplies the values.
    coefficients:
      ρ: {units: kg/m3}
      μ: {units: Pa*s}
      f: {units: N/m3}
