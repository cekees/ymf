# ============================================================
# YMF problem: planar Couette flow, Re = 10
#
# Extends the Navier-Stokes model with a domain, boundary conditions,
# coefficient values, an exact solution, a weak form and a discretization.
# The bottom plate is fixed and the top plate slides at speed U; the flow
# is periodic in x. The exact velocity is linear in y.
# ============================================================

extends: navier_stokes_model.ymf

Problem:
  name: "Planar Couette flow, Re = 10"
  physical_model:
    provenance: human_specified
    assumptions: [steady, fully_developed]   # added to the model's

  # Derived from the coefficients, so each value is stated once.
  characteristic_scales:
    length: {derived: true, formula: "H", units: m}
    velocity: {derived: true, formula: "U", units: m/s}
    density: {derived: true, formula: "ρ", units: kg/m3}
    viscosity: {derived: true, formula: "μ", units: Pa*s}

  dimensionless_numbers:
    Re: {formula: "ρ U H / μ"}

  strong_form:
    domain: "Ω = [0, 4] × [0, H]"
    boundary_regions:
      - name: "bottom"
        geometry: "y = 0"
      - name: "top"
        geometry: "y = H"
      - name: "ends"
        geometry: "x = 0 or x = 4"
      # A single point fixes the pressure's constant: the corner, with its
      # periodic copy.
      - name: "pressure_datum"
        geometry: "x = 0 and y = 0 or x = 4 and y = 0"
    boundary_conditions:
      - region: "ends"
        variable: v
        type: periodic
      - region: "ends"
        variable: p
        type: periodic
      - region: "bottom"
        variable: v
        type: dirichlet
        value: 0.0
      - region: "top"
        variable: v
        type: dirichlet
        formula: "(U, 0)"
      - region: "pressure_datum"
        variable: p
        type: dirichlet
        value: 0.0
    # Values for the coefficients the model declared (units come from the
    # model), and the two this problem adds.
    coefficients:
      ρ: {value: 1.0}
      μ: {value: 0.1}
      f: {formula: "(0, 0)"}
      U: {value: 1.0, units: m/s}      # the top plate's speed
      H: {value: 1.0, units: m}        # the gap

  weak_forms:
    - label: "galerkin_periodic"
      provenance: human_specified
      derivation: |-
        Steady form of the model. Multiply momentum by w and continuity by q,
        integrate over Ω, integrate the viscous and pressure terms by parts.
        Boundary terms vanish on the plates (w = 0) and cancel on the
        periodic ends.
      solution_spaces:
        trial: "H1_per(Ω)² × L2(Ω)"
        test: "H1_per,0(Ω)² × L2(Ω)"
      inf_sup_stability: "requires an inf-sup stable pair"
      bilinear: |-
        ∫Ω ρ (v·∇)v·w dx + ∫Ω μ ∇v:∇w dx - ∫Ω p ∇·w dx + ∫Ω q ∇·v dx
      linear: |-
        l(w) = 0
      stabilization_method: "none"

solution_paths:
  analytical:
    - name: "couette_exact"
      provenance: human_specified
      method: "closed_form"
      solution:
        # p is 0 because the pressure datum fixes it there
        formula: |-
          v = (U y / H, 0)
          p = 0
        notes: "Satisfies the equations exactly for every Re."
  discretizations:
    - name: "taylor_hood"
      provenance: human_specified
      from_weak_form: "galerkin_periodic"
      finite_element:
        velocity: {family: CG, order: 2}
        pressure: {family: CG, order: 1}
      mesh: {cells: [4, 8]}      # a study: one output per mesh
      solver:
        type: nonlinear
        nonlinear_solver: newton
        linear_solver: mumps
        tolerance: 1.0e-12

vvuq:
  verification:
    method: "exact_comparison"
    reference:
      type: "analytical"
      branch_ref: "couette_exact"
    expected: >-
      The exact velocity is linear and the exact pressure constant, so both
      lie in the Taylor-Hood spaces. The discrete solution should equal the
      exact one to solver tolerance on every grid, coarse ones included.
