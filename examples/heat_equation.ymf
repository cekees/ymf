# ============================================================
# YMF Example: transient heat conduction on the unit square
#
# Demonstrates: a time-dependent problem with initial and boundary
# conditions, units on every quantity, a characteristic scale derived from
# a coefficient, and an analytical solution beside two discretizations.
# Every fact is written once; ymf_run reads the same strings people do.
#
# examples/write_archive.py embeds this document in the archive it
# writes, so the output carries the problem it came from.
# ============================================================

Problem:
  name: "Transient heat conduction, unit square"
  physical_model:
    provenance: human_specified
    processes: [heat_conduction]
    assumptions: [constant_properties, no_internal_heat_source]

  units:
    convention: SI
    default: true

  characteristic_scales:
    length: {value: 1.0, units: m}
    temperature: {value: 300.0, units: K}
    # the e-folding time of the slowest mode
    time: {derived: true, formula: "1/(2π²κ)", units: s}

  strong_form:
    provenance: human_specified
    unknowns:
      - name: T
        units: K
    equation_formulation: "heat equation"
    # The divergence form: it stays right if κ ever varies in space,
    # where κΔT would not.
    equations:
      - "∂T/∂t = ∇·(κ∇T)  in Ω"
    domain: "Ω = [0, 1] × [0, 1],  t ∈ (0, 50]"
    boundary_regions:
      - name: "walls"
        geometry: "∂Ω"
    initial_conditions:
      - field: T
        type: function
        formula: "300 + 10 sin(πx) sin(πy)"
        units: K
    boundary_conditions:
      - region: "walls"
        variable: T
        type: dirichlet
        value: 300.0
        units: K
    coefficients:
      κ: {value: 1.0e-3, units: m2/s}
    dimensional_check:
      enabled: true
      method: automatic

  weak_forms:
    - label: "galerkin"
      provenance: human_specified
      derivation: |-
        Multiply by v ∈ H1_0(Ω), integrate over Ω, integrate the
        diffusion term by parts; the boundary term vanishes because
        v = 0 on ∂Ω.
      solution_spaces:
        trial: "H1"
        test: "H1_0"
      bilinear: |-
        m(∂T/∂t, v) + a(T, v),  m(w,v) = ∫Ω w v dx,  a(T,v) = ∫Ω κ ∇T·∇v dx
      linear: |-
        l(v) = 0
      stabilization_method: "none"

solution_paths:
  analytical:
    - name: "separation_of_variables"
      provenance: human_specified
      from_weak_form: "galerkin"
      method: "separation_of_variables"
      solution:
        formula: "T(x, y, t) = 300 + 10 exp(-2π²κt) sin(πx) sin(πy)"
        notes: "Only the (1,1) Fourier mode is excited by the initial condition."

  # The time interval is the problem's (domain, above); a discretization
  # chooses only how to step through it.
  discretizations:
    - name: "P1_backward_euler"
      provenance: human_specified
      from_weak_form: "galerkin"
      finite_element:
        fields: {family: CG, order: 1}
      discretization:
        time_integration: backward_euler
        dt: 1.0
      mesh: {cells: [4, 8, 16]}      # a study: one output per mesh
      solver:
        type: time_marching
        linear_solver: petsc
        tolerance: 1.0e-10

    - name: "P2_backward_euler_fine_dt"
      provenance: human_specified
      from_weak_form: "galerkin"
      finite_element:
        fields: {family: CG, order: 2}
      discretization:
        time_integration: backward_euler
        dt: 0.25
      mesh: {cells: [4, 8, 16]}
      solver:
        type: time_marching
        linear_solver: petsc
        tolerance: 1.0e-10
