# ============================================================
# YMF Example: Kovasznay flow (steady incompressible Navier-Stokes)
#
# Demonstrates: branching. One strong form, two weak forms (a mixed
# inf-sup stable one and a stabilized equal-order one), a discretization
# hanging off each, and an exact solution to verify both against.
# Labels tie the tree together: each discretization names the weak form
# it came from with from_weak_form, and the vvuq block names the branches
# it compares.
#
# Kovasznay (1948) is an exact steady solution behind a periodic array of
# cylinders, so it gives a verification target with nonlinear advection
# switched on. Reynolds number 40, from the characteristic scales below.
# ============================================================

Problem:
  name: "Kovasznay flow, Re = 40"
  physical_model:
    provenance: llm_derived
    processes: [incompressible_flow]
    assumptions: [steady, newtonian, constant_density, two_dimensional]

  units:
    convention: SI
    default: true

  characteristic_scales:
    length: {value: 1.0, units: m}
    velocity: {value: 1.0, units: m/s}
    density: {derived: true, formula: "ρ", units: kg/m3}
    viscosity: {derived: true, formula: "μ", units: Pa*s}
    time: {derived: true, formula: "L_char / U_char"}

  dimensionless_numbers:
    Re: {formula: "ρ U L / μ"}

  strong_form:
    provenance: llm_derived
    unknowns:
      - name: v
        units: m/s
        rank: 1
      - name: p
        units: Pa
    equation_formulation: "incompressible Navier-Stokes, primitive variables"
    # The full momentum equation, solved steadily (which drops ρ ∂v/∂t);
    # conservative form: ∇·(ρ v⊗v) = ρ(v·∇)v because ∇·v = 0.
    equations:
      - "ρ ∂v/∂t + ∇·(ρ v⊗v) − μΔv + ∇p = 0  in Ω"
      - "∇·v = 0  in Ω"
    domain: "Ω = [-0.5, 1.0] × [-0.5, 1.5]"
    boundary_regions:
      - name: "outer"
        geometry: "∂Ω"
      # one point fixes the pressure's constant
      - name: "pressure_datum"
        geometry: "x = -0.5 and y = -0.5"
    # Dirichlet data from the exact solution (Kovasznay 1948): the velocity
    # all round, and the pressure at one point.
    boundary_conditions:
      - region: "pressure_datum"
        variable: p
        type: dirichlet
        formula: "(1 - exp(2λx))/2"
      - region: "outer"
        variable: v
        type: dirichlet
        formula: "(1 - exp(λx) cos(2πy), λ/(2π) exp(λx) sin(2πy))"
    coefficients:
      ρ: {value: 1.0, units: kg/m3}
      μ: {value: 0.025, units: Pa*s}
      # with unit length and velocity scales, Re = ρ/μ = 40
      λ: "ρ/(2μ) - sqrt(ρ²/(4μ²) + 4π²)"

  weak_forms:
    - label: "mixed"
      provenance: llm_derived
      derivation: |-
        Multiply momentum by w ∈ H1_0(Ω)², continuity by q ∈ L2_0(Ω),
        integrate, and integrate the viscous and pressure terms by parts.
      solution_spaces:
        trial: "H1(Ω)² × L2_0(Ω)"
        test: "H1_0(Ω)² × L2_0(Ω)"
      inf_sup_stability: "requires an inf-sup stable pair, e.g. Taylor-Hood"
      bilinear: |-
        a(v,w) + c(v; v,w) - b(w,p) + b(v,q),
        a(v,w) = ∫Ω μ ∇v:∇w dx,  c(z; v,w) = ∫Ω ρ (z·∇)v·w dx,
        b(w,p) = ∫Ω p ∇·w dx
      linear: |-
        l(w) = 0
      stabilization_method: "none"

    - label: "stabilized_equal_order"
      provenance: llm_derived
      derivation: |-
        As "mixed", plus residual-based SUPG/PSPG terms so that equal-order
        velocity and pressure spaces are stable.
      solution_spaces:
        trial: "H1(Ω)² × H1(Ω)"
        test: "H1_0(Ω)² × H1(Ω)"
      inf_sup_stability: "circumvented by PSPG stabilization"
      bilinear: |-
        (mixed form) + Σ_K τ_K ∫K R(v,p)·(ρ (v·∇)w + ∇q) dx
      linear: |-
        l(w) = 0
      stabilization_method: "SUPG/PSPG"

solution_paths:
  analytical:
    - name: "kovasznay_exact"
      provenance: human_specified
      method: "closed_form"
      solution:
        formula: |-
          v = (1 - exp(λx) cos(2πy), λ/(2π) exp(λx) sin(2πy))
          p = (1 - exp(2λx))/2
        notes: "L. I. G. Kovasznay, Proc. Camb. Phil. Soc. 44 (1948) 58-62. Exact for every Re."

  discretizations:
    - name: "taylor_hood"
      provenance: llm_derived
      from_weak_form: "mixed"
      finite_element:
        velocity: {family: CG, order: 2}
        pressure: {family: CG, order: 1}
      solver:
        type: nonlinear
        nonlinear_solver: newton
        linear_solver: mumps
        tolerance: 1.0e-10
        max_iterations: 20

    - name: "equal_order_p1"
      provenance: llm_derived
      from_weak_form: "stabilized_equal_order"
      finite_element:
        velocity: {family: CG, order: 1}
        pressure: {family: CG, order: 1}
      solver:
        type: nonlinear
        nonlinear_solver: newton
        linear_solver: petsc
        tolerance: 1.0e-10
        max_iterations: 20

# The verification plan. Results are appended under each branch after the
# discretizations have been run; none are recorded here because neither
# branch has been run for this example.
vvuq:
  verification:
    method: "exact_comparison"
    grid_levels: [16, 32, 64]
    reference:
      type: "analytical"
      branch_ref: "kovasznay_exact"
    branches: ["taylor_hood", "equal_order_p1"]
    expected_rates:  # a priori L2 rates on smooth solutions
      taylor_hood: {error_L2_velocity: 3, error_L2_pressure: 2}
      equal_order_p1: {error_L2_velocity: 2, error_L2_pressure: 1}
